# Settings for docker-compose.yml. Copy to .env and edit:  cp .env.example .env

# Sign-in name and password (at least 12 characters). There is no default
# password: the container does not start without one.
EZEUS_USER=zeus
EZEUS_PASSWORD=

# Where the game files come from:
#   server - from EZEUS_GAME_PATH on this host; browsers import them after sign-in
#   local  - every browser picks its own Zeus and Poseidon folder
EZEUS_GAME_SOURCE=server

# Your Zeus and Poseidon folder on the host (the one with an eZeus release folder inside).
# Only read with EZEUS_GAME_SOURCE=server.
EZEUS_GAME_PATH=./game

# Where the saves, their older versions and the session secret are kept.
# Without it they go to the Docker volume ezeus-data. Set a folder on the
# host (a path with a slash) to have them there as files, the saves in its
# saves/ subfolder; the folder has to be writable for user 1000.
#EZEUS_DATA_PATH=/path/to/ezeus-data

# Port on the host. Point your HTTPS reverse proxy at it.
EZEUS_HTTP_PORT=8080

# How many days a sign-in lasts
EZEUS_SESSION_DAYS=30

# 1 when a reverse proxy is in front of the port, 0 when browsers reach it directly
EZEUS_TRUST_PROXY=1
